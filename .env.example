HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Optional locally. Both required in production; distinct random values.
ADMIN_TOKEN=
DELIVERY_A_TOKEN=
# Vercel only: dedicated Redis for this mock laboratory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Distinct key per environment when sharing laboratory Redis.
LAB_REDIS_KEY=pop9-mock-server:v1:delivery-a
# Outgoing webhook credential (server-side secret). Must match the Hub source credential.
# Do NOT set to ADMIN_TOKEN or DELIVERY_A_TOKEN. Never prefix with 'Bearer ' here.
# Only configure on an isolated environment whose webhookDestination points to your Hub lab.
HUB_WEBHOOK_BEARER_TOKEN=
# Exact trusted HTTPS URL of the Hub webhook source. Required when Bearer token is set.
HUB_WEBHOOK_DESTINATION=
